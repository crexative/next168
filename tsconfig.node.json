{
  "extends": "@tsconfig/node22/tsconfig.json",
  "include": [
    "config/**/*.ts",
    "vite.config.*",
    "vitest.config.*",
    "eslint.config.*",
    "server/**/*.spec.ts",
    "server/**/testing/**/*.ts"
  ],
  "compilerOptions": {
    "noEmit": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": [
      "node"
    ]
  }
}
