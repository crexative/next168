{
  "name": "next168",
  "version": "1.0.0",
  "description": "Weeklid (formerly Next168) - A smart weekly planner that helps you visualize, structure, and balance your time with clarity and purpose.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "lan:cert": "node scripts/lan-cert.mjs",
    "preview:lan": "node scripts/preview-lan.mjs",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "eslint . --fix",
    "test": "vitest",
    "test:spike": "node --test scripts/spikes/google-oauth-spike.test.mjs",
    "perf": "NEXT168_PERF=reference vitest run src/core/__tests__/schedulingPerf.test.ts -t \"wall time\"",
    "e2e": "playwright test",
    "companion:build": "npm --prefix companion run build",
    "companion:start": "node companion/dist/cli.js serve",
    "test:e2e:linux": "bash scripts/e2e-linux.sh"
  },
  "dependencies": {
    "@mlc-ai/web-llm": "0.2.85",
    "ical.js": "2.2.1",
    "lucide-vue-next": "0.577.0",
    "motion": "14.1.0",
    "pinia": "^3.0.3",
    "vue": "^3.5.22",
    "vue-i18n": "^9.14.5",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@cloudflare/workers-types": "5.20261013.1",
    "@playwright/test": "1.63.0",
    "@tsconfig/node22": "^22.0.2",
    "@types/node": "^22.18.6",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vitest/coverage-v8": "3.2.4",
    "@vitest/ui": "^3.2.4",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/tsconfig": "^0.8.1",
    "eslint": "^9.33.0",
    "eslint-plugin-vue": "~10.4.0",
    "fake-indexeddb": "6.2.5",
    "happy-dom": "^20.0.7",
    "jiti": "^2.5.1",
    "npm-run-all2": "^8.0.4",
    "typescript": "~5.9.0",
    "vite": "^7.1.7",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.1.0",
    "wrangler": "4.149.0"
  }
}
